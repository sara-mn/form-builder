{
  "name": "form-builder",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-prod": "ng build --configuration production --base-href /form-builder/",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts,html,scss,css,json}\" --cache",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,mts,d.ts,html,scss,css,json}\"",
    "test": "ng test",
    "mock-server": "node server/index.js",
    "start:server": "node server/index.js",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.0.3",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@primeicons/angular": "^8.0.0",
    "@primeuix/themes": "^3.0.0-rc.1",
    "@tailwindcss/postcss": "^4.1.4",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.4.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "json-server": "^0.17.4",
    "jsonwebtoken": "^9.0.3",
    "postcss": "^8.5.3",
    "primeng": "^22.0.0-rc.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.4",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@vitest/browser-playwright": "^4.1.10",
    "angular-eslint": "22.5.0",
    "body-parser": "^2.3.0",
    "eslint": "^10.9.1",
    "happy-dom": "^20.11.1",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true
  },
  "engines": {
    "node": "24.x"
  }
}
